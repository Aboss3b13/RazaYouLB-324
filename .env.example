# Kopieren nach .env und Werte anpassen. Die .env wird NICHT eingecheckt.
# Ohne Datenbank-Angaben speichert der Server die Notizen nur im Arbeitsspeicher.

# Variante 1: ganze Verbindung
# DATABASE_URL=postgres://benutzer:passwort@localhost:5432/notizen

# Variante 2: einzeln (wie im Modul-Auftrag 1650)
DBNAME=notizen
DBHOST=localhost:5432
DBUSER=postgres
DBPASS=geheim

PORT=3000
